# Pi の ~/raspi-smart-speaker/.env にコピーして値を入れる（.env はコミットしない）
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 以下は任意（既定値）
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# GOOGLE_STT_MODEL=latest_short
# STT は google / reazon / whisper。ローカルは先に scripts/fetch_models.sh でモデルを落とす
# STT_ENGINE=google
# STT_REAZON_INT8=1
# whisper のモデルは faster-whisper-small または kotoba-whisper-v2.0-faster
# STT_WHISPER_MODEL=faster-whisper-small
# STT_WHISPER_BEAM=1
# STT_THREADS=4
# TTS は google / openjtalk / voicevox。ローカルは先に scripts/fetch_models.sh でモデルを落とす
# TTS_ENGINE=google
# GOOGLE_TTS_VOICE=ja-JP-Neural2-B
# TTS_OPENJTALK_VOICE=mei
# TTS_OPENJTALK_SPEED=1.0
# TTS_VOICEVOX_STYLE=3
# 1 = 回答を 1 文ずつ合成して、1 文目ができたら再生を始める。0 = 全文をまとめて合成する（段階 1 と同じ）
# TTS_SPLIT=1
# 入力は enter / wakeword。wakeword は models/wakeword/r2d2.onnx を置いてから（scripts/ww_train.py で作る）
# INPUT=enter
# 確認役ありでのしきい値。確認役がなければ 0.5 前後にする
# WAKEWORD_THRESHOLD=0.95
# 1 = 確認役（models/wakeword/r2d2_verifier.pkl。scripts/ww_verifier.py で作る）があれば使う
# WAKEWORD_VERIFIER=1
# 本体のスコアがこれを超えたら確認役のスコアに置き換える
# WAKEWORD_VERIFIER_THRESHOLD=0.5
# 話し始めてからこの長さ無音が続いたら録音を止める
# WAKEWORD_SILENCE_MS=800
# WAKEWORD_MAX_SEC=10
# 雑音の床よりこれだけ大きければ話しているとみなす（dB）
# WAKEWORD_SPEECH_DB=10
