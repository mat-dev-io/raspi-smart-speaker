# Pi の ~/raspi-smart-speaker/.env にコピーして値を入れる（.env はコミットしない）
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 以下は任意（既定値）
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# GOOGLE_STT_MODEL=latest_short
# STT は google / reazon / whisper。ローカルは先に scripts/fetch_models.sh でモデルを落とす
# STT_ENGINE=google
# STT_REAZON_INT8=1
# whisper のモデルは faster-whisper-small または kotoba-whisper-v2.0-faster
# STT_WHISPER_MODEL=faster-whisper-small
# STT_WHISPER_BEAM=1
# STT_THREADS=4
# GOOGLE_TTS_VOICE=ja-JP-Neural2-B
